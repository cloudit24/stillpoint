<?xml version="1.0" encoding="utf-8"?>
<!-- Stillpoint Gold: warm gold glow, a gold coin dot beside the label, the price large and thin. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gold_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow"
        android:tint="#FFE0C068" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot"
                android:tint="#FFE0C068" />

            <TextView
                android:id="@+id/gold_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textColor="#FFE0C068"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/gold_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFF3EBD3"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/gold_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF9A978F"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
