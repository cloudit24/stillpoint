<?xml version="1.0" encoding="utf-8"?>
<!-- Every built-in address Stillpoint uses is https. Plain http is allowed only because a self-hosted
     Project Hub on a home network (e.g. http://192.168.1.10:8700) often has no certificate; Android can't
     limit this to private addresses, so the connect screen warns when a non-home address uses http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
